# Audio assets - keep placeholders, avoid committing licensed files accidentally
assets/music/*.mp3
assets/music/*.wav
assets/sfx/*.mp3
assets/sfx/*.wav

# Keep folder placeholders if you add them
!assets/music/.gitkeep
!assets/sfx/.gitkeep
!input/.gitkeep
!output/.gitkeep

